    {
      "id": "login-zhihu-search",
      "group": "login",
      "site": "zhihu",
      "prompt": "用知乎搜索“大模型 Agent”，给我前 5 条问题的标题和链接。",
      "check": {
        "min_links": 5,
        "link_domain": "zhihu.com"
      },
      "via_browser": true
    },
    {
      "id": "multistep-bilibili",
      "group": "multi_step",
      "site": "bilibili",
      "prompt": "分三步完成：先获取B站热门第 1 条视频，再打开B站热门页面确认它仍在第 1 位，最后获取热门前 2 条视频的标题和链接。",
      "check": {
        "min_links": 2,
        "link_domain": "bilibili.com"
      },
      "via_browser": true
    },
    {
      "id": "multistep-compare",
      "group": "multi_step",
      "site": "hackernews",
      "prompt": "Compare the top 3 Hacker News stories with the top 3 GitHub trending repositories: list both with links and say whether any topic appears in both.",
      "check": {
        "min_links": 6,
        "link_domain": ""
      },
      "via_browser": true
    },
    {
      "id": "routing-hackernews",
      "group": "routing",
      "site": "hackernews",
      "via_browser": false,
      "prompt": "What are the top 5 stories on Hacker News right now? Give title and link.",
      "check": {
        "min_links": 5,
        "link_domain": ""
      }
    },
    {
      "id": "routing-bilibili",
      "group": "routing",
      "site": "bilibili",
      "via_browser": false,
      "prompt": "B站热门前 3 条视频是什么？给出标题、UP主和链接。",
      "check": {
        "min_links": 3,
        "link_domain": "bilibili.com"
      }
    },
    {
      "id": "routing-wikipedia",
      "group": "routing",
      "site": "wikipedia",
      "via_browser": false,
      "prompt": "Summarize the Wikipedia article on WebSocket in two sentences and give the link.",
      "check": {
